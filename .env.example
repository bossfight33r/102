# Скопируйте в .env и заполните. .env не коммитится.
YOUTUBE_API_KEY=
ANTHROPIC_API_KEY=
# claude-haiku-4-5 — дёшево (~$0.01 за разбор); claude-sonnet-5-5 — ~$0.04; claude-opus-5-5 — ~$0.08
ANTHROPIC_MODEL=claude-haiku-4-5
TELEGRAM_BOT_TOKEN=
# Telegram user id через запятую: бот отвечает только им
ADMIN_IDS=

# Необязательно
RADAR_DATA_DIR=data
RADAR_CONFIG_DIR=config
LOG_LEVEL=INFO
LOG_JSON=false
# RADAR_FAKE=1 — демо-режим без ключей: фейковые YouTube/LLM/Telegram на tests/fixtures
RADAR_FAKE=0
