# Скопируйте в .env и заполните. .env не коммитится.
YOUTUBE_API_KEY=
# --- LLM для анализа (см. docs/llm.md) ---
# Провайдер: gemini | deepseek | openai | openrouter | ollama | custom | anthropic
LLM_PROVIDER=gemini
# Пусто — модель по умолчанию провайдера (gemini-3.5-flash-lite, deepseek-flash, gpt-5-mini,
# google/gemini-3.5-flash-lite, qwen3-vl:8b). Для anthropic — например claude-haiku-4-5.
LLM_MODEL=
# Ключ провайдера (для ollama не нужен). Для anthropic можно ANTHROPIC_API_KEY.
LLM_API_KEY=
# Только для custom или своего адреса (например, Ollama на другой машине)
LLM_BASE_URL=
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
# Telegram user id через запятую: бот отвечает только им
ADMIN_IDS=

# Необязательно
RADAR_DATA_DIR=data
RADAR_CONFIG_DIR=config
LOG_LEVEL=INFO
LOG_JSON=false
# RADAR_FAKE=1 — демо-режим без ключей: фейковые YouTube/LLM/Telegram на tests/fixtures
RADAR_FAKE=0
