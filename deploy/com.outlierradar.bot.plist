<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- radar bot — постоянно работающий процесс, перезапускается при падении. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.outlierradar.bot</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd "__PROJECT_DIR__" &amp;&amp; uv run radar bot</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/data/logs/bot.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/data/logs/bot.err.log</string>
</dict>
</plist>
